<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
      xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd 
        http://www.mulesoft.org/schema/mule/core
        http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/munit
        http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
        http://www.mulesoft.org/schema/mule/munit-tools
        http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd">

    <munit:config name="new-test-suite.xml"/>

    <!-- ====================================================== -->
    <!-- 1. UPSERT CONTACT - SUCCESS                            -->
    <!-- ====================================================== -->

    <munit:test name="upsert-contact-success-test"
                description="Test successful upsert contact">

        <munit:behavior>
            <munit-tools:mock-when processor="salesforce:upsert">
                <munit-tools:then-return>
                    <munit-tools:payload
                        value="#[{successful: true, items: [{successful: true, id: '003TEST001'}]}]"
                        mediaType="application/java"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>

        <munit:execution>
            <munit:set-event>
                <munit:payload
                    value="#[{externalId: 'EBS001', lastName: 'Reddy', firstName: 'Ravi', email: 'ravi@example.com'}]"
                    mediaType="application/java"/>
            </munit:set-event>

            <flow-ref name="upsert-contact-flow"/>
        </munit:execution>

        <munit:validation>
            <munit-tools:assert-that
                expression="#[vars.httpStatus]"
                is="#[MunitTools::equalTo(200)]"/>

            <munit-tools:assert-that
                expression="#[payload.success]"
                is="#[MunitTools::equalTo(true)]"/>
        </munit:validation>

    </munit:test>


    <!-- ====================================================== -->
    <!-- 2. UPSERT CONTACT - SALESFORCE UNSUCCESSFUL             -->
    <!-- ====================================================== -->

    <munit:test name="upsert-contact-unsuccessful-test"
                description="Test unsuccessful Salesforce upsert result">

        <munit:behavior>
            <munit-tools:mock-when processor="salesforce:upsert">
                <munit-tools:then-return>
                    <munit-tools:payload
                        value="#[{successful: false, items: [{successful: false, errors: ['Upsert failed']}]}]"
                        mediaType="application/java"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>

        <munit:execution>
            <munit:set-event>
                <munit:payload
                    value="#[{externalId: 'EBS002', lastName: 'Kumar', firstName: 'Raj'}]"
                    mediaType="application/java"/>
            </munit:set-event>

            <flow-ref name="upsert-contact-flow"/>
        </munit:execution>

        <munit:validation>
            <munit-tools:assert-that
                expression="#[vars.httpStatus]"
                is="#[MunitTools::equalTo(400)]"/>

            <munit-tools:assert-that
                expression="#[payload.success]"
                is="#[MunitTools::equalTo(false)]"/>
        </munit:validation>

    </munit:test>


    <!-- ====================================================== -->
    <!-- 3. UPSERT CONTACT - VALIDATION ERROR                   -->
    <!-- ====================================================== -->

    <munit:test name="upsert-contact-validation-test"
                description="Test upsert validation when required fields are missing">

        <munit:execution>
            <munit:set-event>
                <munit:payload
                    value="#[{email: 'invalid@example.com'}]"
