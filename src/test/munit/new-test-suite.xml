    <!-- 4. UPSERT CONTACT - ERROR HANDLER                      -->
    <!-- ====================================================== -->

    <munit:test name="upsert-contact-error-handler-test"
                description="Test upsert error handler">

        <munit:behavior>
            <munit-tools:mock-when processor="salesforce:upsert">
                <munit-tools:then-return>
                    <munit-tools:error typeId="MULE:EXPRESSION"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>

        <munit:execution>
            <munit:set-event>
                <munit:payload
                    value="#[{externalId: 'EBS003', lastName: 'ErrorTest', firstName: 'Test'}]"
                    mediaType="application/java"/>
            </munit:set-event>

            <flow-ref name="upsert-contact-flow"/>
        </munit:execution>

        <munit:validation>
            <munit-tools:assert-that
                expression="#[vars.httpStatus]"
                is="#[MunitTools::equalTo(500)]"/>
        </munit:validation>

    </munit:test>


    <!-- ====================================================== -->
    <!-- 5. GET CONTACT BY ID - FOUND                           -->
    <!-- ====================================================== -->

    <munit:test name="get-contact-by-id-found-test"
                description="Test retrieving an existing contact">

        <munit:behavior>
            <munit-tools:mock-when processor="salesforce:query">
                <munit-tools:then-return>
                    <munit-tools:payload
                        value="#[[{Id: '003TEST001', FirstName: 'Ravi', LastName: 'Reddy', Email: 'ravi@example.com'}]]"
                        mediaType="application/java"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>

        <munit:execution>
            <munit:set-event>
                <munit:attributes
                    value="#[{uriParams: {contactId: '003TEST001'}}]"
                    mediaType="application/java"/>
            </munit:set-event>

            <flow-ref name="get-contact-by-id-flow"/>
        </munit:execution>

        <munit:validation>
            <munit-tools:assert-that
                expression="#[vars.httpStatus]"
                is="#[MunitTools::equalTo(200)]"/>
        </munit:validation>

    </munit:test>


    <!-- ====================================================== -->
    <!-- 6. GET CONTACT BY ID - NOT FOUND                       -->
    <!-- ====================================================== -->

    <munit:test name="get-contact-by-id-not-found-test"
                description="Test retrieving a contact that does not exist">

        <munit:behavior>
            <munit-tools:mock-when processor="salesforce:query">
                <munit-tools:then-return>
                    <munit-tools:payload
                        value="#[[]]"
                        mediaType="application/java"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>

        <munit:execution>
            <munit:set-event>
                <munit:attributes
                    value="#[{uriParams: {contactId: '003MISSING001'}}]"
                    mediaType="application/java"/>
            </munit:set-event>

            <flow-ref name="get-contact-by-id-flow"/>
        </munit:execution>

        <munit:validation>
            <munit-tools:assert-that
                expression="#[vars.httpStatus]"
                is="#[MunitTools::equalTo(404)]"/>
        </munit:validation>

    </munit:test>


    <!-- ====================================================== -->
    <!-- 7. GET CONTACT BY ID - ERROR HANDLER                   -->
    <!-- ====================================================== -->

    <munit:test name="get-contact-by-id-error-test"
